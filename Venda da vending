from datetime import datetime, timedelta

def calcular_preco_dinamico_mundial(preco_base, temperatura_atual, horas_para_vencer, stock_atual):
    """
    Algoritmo Científico de Otimização de Lucro e Margem em Tempo Real.
    Nenhuma máquina de vending atual possui este cálculo preditivo integrado à validação local.
    """
    preco_final = preco_base
    fatores_aplicados = []

    # Fator 1: Elasticidade de Procura por Clima Extremo
    if temperatura_atual >= 32.0:
        # Aumenta a margem de bebidas frias de forma segura (Aproveita a alta procura)
        preco_final *= 1.15
        fatores_aplicados.append("Ajuste Térmico (+15% Alta Procura devido ao Calor)")
    elif temperatura_atual <= 8.0:
        # Incentiva o consumo de produtos quentes ou snacks pesados
        preco_final *= 1.05
        fatores_aplicados.append("Ajuste Térmico (+5% Clima Frio)")

    # Fator 2: Desconto Crítico de Validade Progressiva (Anti-Desperdício)
    if horas_para_vencer <= 2:
        # Falta muito pouco tempo: liquida o produto para recuperar o custo de aquisição
        preco_final *= 0.40
        fatores_aplicados.append("Liquidação Anti-Desperdício (-60% Validade Próxima)")
    elif horas_para_vencer <= 6:
        preco_final *= 0.70
        fatores_aplicados.append("Desconto de Validade Ativo (-30%)")
    elif horas_para_vencer <= 12:
        preco_final *= 0.90
        fatores_aplicados.append("Desconto de Validade Preventivo (-10%)")

    # Fator 3: Escassez de Stock (Lei da Oferta e da Procura)
    if stock_atual == 1 and preco_final == preco_base:
        # Última unidade no canal: o cliente premium paga mais pela conveniência imediata
        preco_final *= 1.10
        fatores_aplicados.append("Prémio de Escassez (+10% Última Unidade)")

    # Garante que o preço nunca desce abaixo do custo mínimo de segurança ou fica inflacionado de forma absurda
    preco_final = max(preco_base * 0.40, min(preco_final, preco_base * 1.50))
    
    return round(preco_final, 2), fatores_aplicados


