# --- MOTOR E ESTADO DA MÁQUINA ---
class VendingMachine:
    def __init__(self):
        self.saldo = Decimal("0.00")
        self.produtos = {
            "A1": {"nome": "Coca-Cola", "preco": Decimal("1.50"), "stock": 3},
            "A2": {"nome": "Água Mineral", "preco": Decimal("1.00"), "stock": 5},
            "A3": {"nome": "Sprite", "preco": Decimal("1.40"), "stock": 4},
            "B1": {"nome": "Batatas Fritas", "preco": Decimal("1.20"), "stock": 2},
            "B2": {"nome": "Chocolates", "preco": Decimal("1.80"), "stock": 3},
            "B3": {"nome": "Energético", "preco": Decimal("2.50"), "stock": 4}
        }
        self.tubos = {Decimal("2.00"): 10, Decimal("1.00"): 10, Decimal("0.50"): 20, Decimal("0.20"): 20, Decimal("0.10"): 30}

    def calc_troco(self, val: Decimal) -> dict:
        res, resto = {}, val
        for m in sorted(self.tubos.keys(), reverse=True):
            if resto <= 0: break
            qtd = min(int(resto // m), self.tubos[m])
            if qtd > 0: res[m] = qtd; resto -= m * qtd
        return res if resto == 0 else None

    def atualizar_bolsa(self, slot):
        for s, p in self.produtos.items():
            if s == slot: p["preco"] = max(Decimal("0.50"), p["preco"] + Decimal("0.10"))
            else: p["preco"] = max(Decimal("0.40"), p["preco"] - Decimal("0.05"))

