        self.up_ui()
        logger.info(f"🪙 +{v}€ | Saldo: {self.vm.saldo:.2f}€")

    def simular_mbway(self):
        self.cv.itemconfig(self.lbl_pique, text="📱 A VALIDAR MB WAY...", fill="#e83e8c")
        self.root.after(1200, self._concluir_mbway)

    def _concluir_mbway(self):
        self.vm.saldo += Decimal("2.50")
        self.up_ui()
        self.animar_pique("", "mbway")
        logger.info("📱 MB WAY carregado com sucesso: +2.50€")

    def devolver_troco(self):
        if self.vm.saldo > 0:
            t = self.vm.calc_troco(self.vm.saldo)
            if t is not None:
                logger.info(f"🔄 Troco total de {self.vm.saldo:.2f}€ devolvido:")
                for m, q in t.items(): 
                    self.vm.tubos[m] -= q
                    logger.info(f"  -> {q}x {m}€")
                self.vm.saldo = Decimal("0.00")
            else: 
                logger.warning("⚠️ Troco exato indisponível nos tubos de moedas!")
            self.up_ui()
        else: 
            logger.info("ℹ️ Não existe saldo acumulado para devolver.")

    def executing_venda_logica(self, slot):
        if slot == "DESTINO":
            validos = [s for s, p in self.vm.produtos.items() if p["stock"] > 0]
            if not validos: 
                logger.error("❌ Máquina Esgotada! Destino cancelado.")
                return
            slot, preco, tipo = random.choice(validos), Decimal("1.10"), "destino"
        else: 
            preco, tipo = self.vm.produtos[slot]["preco"], "alta"
            
        p = self.vm.produtos[slot]
        if p["stock"] <= 0: 
            logger.warning(f"❌ [{slot}] encontra-se esgotado.")
        elif self.vm.saldo < preco: 
            logger.warning(f"💰 Saldo insuficiente para [{slot}] ({preco:.2f}€).")
        else:
            p["stock"] -= 1
            self.vm.saldo -= preco
            self.vm.atualizar_bolsa(slot)
            self.up_ui()
            self.animar_pique(p['nome'], tipo)
            self.emitir_recibo_legal(p['nome'], preco)
            logger.info(f"🥤 Entregue: {p['nome']}! (Restam {p['stock']} un)")

    def executar_venda(self, slot):
        self.root.after(0, lambda: self.executing_venda_logica(slot))

    def up_ui(self):
        self.lbl_saldo.config(text=f"{self.vm.saldo:.2f}€")
        for s, p in self.vm.produtos.items(): 
            st = "ESGOTADO" if p["stock"] <= 0 else f"{p['preco']:.2f}€ ({p['stock']})"
            self.b_prods[s].config(text=f"[{s}] {p['nome']:<16} | {st}")
            
    def reset_ecra(self):
